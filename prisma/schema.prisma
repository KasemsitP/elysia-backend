  accounts                 accounts?                  @relation(fields: [created_by_account_id], references: [id], onUpdate: NoAction, map: "fk_bags_created_by_account")
  sessions                 sessions                   @relation(fields: [session_id, campaign_id], references: [id, campaign_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bags_session")
  booklet_incident_reports booklet_incident_reports[]
  booklet_question_notes   booklet_question_notes[]
