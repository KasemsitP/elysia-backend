  @@unique([session_id, bag_no], map: "uq_bags_session_bagno")
  @@unique([id, campaign_id, session_id], map: "uq_bags_id_campaign_session")
  @@index([session_id, campaign_id], map: "fk_bags_session")
  @@index([campaign_id], map: "idx_bags_campaign")
  @@index([created_by_account_id], map: "idx_bags_created_by")
  @@index([session_id], map: "idx_bags_session")
  @@index([status], map: "idx_bags_status")
