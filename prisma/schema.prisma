/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model booklets {
  id                       Int                        @id @default(autoincrement())
  campaign_id              Int
  session_id               Int
  user_code                String?                    @db.VarChar(32)
  qr_payload               String                     @unique(map: "uq_booklets_qr_payload") @db.VarChar(512)
  bag_id                   Int?
  seq_in_bag               Int?                       @db.SmallInt
  random_num               String?                    @db.VarChar(6)
  status                   String                     @default("PRINTED") @db.VarChar(16)
  created_at               DateTime                   @default(now()) @db.DateTime(0)
  updated_at               DateTime                   @default(now()) @db.DateTime(0)
  deleted_at               DateTime?                  @db.DateTime(0)
  booklet_incident_reports booklet_incident_reports[]
  booklet_question_choices booklet_question_choices[]
  booklet_question_notes   booklet_question_notes[]
  bags                     bags?                      @relation(fields: [bag_id, campaign_id, session_id], references: [id, campaign_id, session_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_booklets_bag")
  exam_campaigns           exam_campaigns             @relation(fields: [campaign_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_booklets_campaign")
  sessions                 sessions                   @relation(fields: [session_id, campaign_id], references: [id, campaign_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_booklets_session")
  grading_score_drafts     grading_score_drafts[]
  grading_score_logs       grading_score_logs[]
  grading_slots            grading_slots[]
  qr_scan_logs             qr_scan_logs[]

  @@unique([session_id, random_num], map: "session_id")
  @@unique([session_id, random_num], map: "uq_booklets_session_random")
  @@unique([session_id, user_code], map: "uq_booklets_session_user")
  @@index([bag_id, campaign_id, session_id], map: "fk_booklets_bag")
  @@index([campaign_id], map: "idx_booklets_campaign")
  @@index([user_code], map: "idx_booklets_user_code")
  @@index([session_id, campaign_id], map: "fk_booklets_session")
  @@index([bag_id], map: "idx_booklets_bag")
  @@index([campaign_id, session_id, status, bag_id], map: "idx_booklets_packaging_lookup")
  @@index([session_id], map: "idx_booklets_session")
  @@index([session_id, qr_payload], map: "idx_booklets_session_payload")
  @@index([status], map: "idx_booklets_status")
}

