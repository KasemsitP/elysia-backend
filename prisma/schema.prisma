generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model accounts {
  id                                                                                 Int                        @id @default(autoincrement())
  username                                                                           String                     @db.VarChar(64)
  password_hash                                                                      String                     @db.VarChar(256)
  title                                                                              String?                    @db.VarChar(20)
  full_name                                                                          String                     @db.VarChar(128)
  email                                                                              String?                    @db.VarChar(128)
  profile_image_url                                                                  String?                    @db.VarChar(512)
  profile_image_key                                                                  String?                    @db.VarChar(512)
  active                                                                             Boolean                    @default(true)
  role_id                                                                            Int
  campaign_id                                                                        Int?
  session_version                                                                    Int                        @default(1)
  manager_order                                                                      Int?                       @db.TinyInt
  created_at                                                                         DateTime                   @default(now()) @db.DateTime(0)
  updated_at                                                                         DateTime                   @default(now()) @db.DateTime(0)
  deleted_at                                                                         DateTime?                  @db.DateTime(0)
  active_unique_key                                                                  Int?                       @db.TinyInt
  exam_campaigns                                                                     exam_campaigns?            @relation(fields: [campaign_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_accounts_campaign")
  roles                                                                              roles                      @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "accounts_ibfk_1")
  activity_logs                                                                      activity_logs[]
  auth_sessions                                                                      auth_sessions[]
  bags                                                                               bags[]
  booklet_incident_reports_booklet_incident_reports_assigned_to_account_idToaccounts booklet_incident_reports[] @relation("booklet_incident_reports_assigned_to_account_idToaccounts")
  booklet_incident_reports_booklet_incident_reports_reported_by_account_idToaccounts booklet_incident_reports[] @relation("booklet_incident_reports_reported_by_account_idToaccounts")
  booklet_incident_reports_booklet_incident_reports_resolved_by_account_idToaccounts booklet_incident_reports[] @relation("booklet_incident_reports_resolved_by_account_idToaccounts")
  booklet_question_notes_booklet_question_notes_created_by_account_idToaccounts      booklet_question_notes[]   @relation("booklet_question_notes_created_by_account_idToaccounts")
  booklet_question_notes_booklet_question_notes_reviewed_by_account_idToaccounts     booklet_question_notes[]   @relation("booklet_question_notes_reviewed_by_account_idToaccounts")
  campaign_keys                                                                      campaign_keys[]
  campaign_settings_campaign_settings_created_by_account_idToaccounts                campaign_settings[]        @relation("campaign_settings_created_by_account_idToaccounts")
  campaign_settings_campaign_settings_updated_by_account_idToaccounts                campaign_settings[]        @relation("campaign_settings_updated_by_account_idToaccounts")
  grader_work_locks                                                                  grader_work_locks[]
  graders                                                                            graders[]
  grading_score_logs                                                                 grading_score_logs[]
  incident_attachments                                                               incident_attachments[]
  notification_messages                                                              notification_messages[]
  notification_preferences                                                           notification_preferences[]
  notification_recipients                                                            notification_recipients[]
  qr_scan_logs                                                                       qr_scan_logs[]
  twofactor_sessions                                                                 twofactor_sessions[]

  @@unique([username, active_unique_key], map: "uq_accounts_username_active")
  @@index([active], map: "idx_accounts_active")
  @@index([campaign_id], map: "idx_accounts_campaign")
  @@index([role_id], map: "idx_accounts_role")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model activity_logs {
  id          Int       @id @default(autoincrement())
  event_time  DateTime  @default(now()) @db.DateTime(0)
  actor_type  String    @db.VarChar(16)
  account_id  Int?
  grader_id   Int?
  action      String    @db.VarChar(64)
  object_type String?   @db.VarChar(64)
  object_id   Int?
  details     Json?
  ip_address  String?   @db.VarChar(64)
  user_agent  String?   @db.Text
  accounts    accounts? @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_logs_ibfk_1")
  graders     graders?  @relation(fields: [grader_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_logs_ibfk_2")

  @@index([account_id], map: "idx_activity_account")
  @@index([event_time], map: "idx_activity_event_time")
  @@index([grader_id], map: "idx_activity_grader")
  @@index([object_type, object_id], map: "idx_activity_object")
}

model auth_sessions {
  sid        String    @id @db.VarChar(128)
  account_id Int?
  expires    Int       @db.UnsignedInt
  data       String    @db.Text
  created_at DateTime  @default(now()) @db.DateTime(0)
  updated_at DateTime  @default(now()) @db.DateTime(0)
  accounts   accounts? @relation(fields: [account_id], references: [id], onUpdate: NoAction, map: "fk_auth_session_accounts")

  @@index([account_id], map: "idx_auth_sessions_account")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model bags {
  id                       Int                        @id @default(autoincrement())
